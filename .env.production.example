# 复制为 .env.production；不得提交真实密码和密钥。
MYSQL_DATABASE=fund_keeper
MYSQL_USER=fund_keeper
MYSQL_PASSWORD=replace-with-a-strong-database-password
MYSQL_ROOT_PASSWORD=replace-with-another-strong-root-password

DB_USERNAME=fund_keeper
DB_PASSWORD=replace-with-the-same-database-password

# 生产环境不能使用本地 Mailpit。可配置 Brevo 等 SMTP 服务。
MAIL_HOST=smtp-relay.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_SMTP_AUTH=true
MAIL_STARTTLS=true
AUTH_MAIL_FROM=no-reply@example.com

# 使用 `openssl rand -base64 32` 分别生成，两个值不能相同。
AUTH_JWT_SECRET_BASE64=replace-with-a-random-base64-secret
AUTH_VERIFICATION_SECRET_BASE64=replace-with-another-random-base64-secret

FUND_REFERENCE_DATA_PROVIDER=eastmoney-public
FUND_REFERENCE_DATA_SYNC_ON_STARTUP=true
FUND_REFERENCE_DATA_SCHEDULE_ENABLED=true
FUND_VALUATION_PROVIDER=eastmoney-market
FUND_VALUATION_REFRESH_ENABLED=true

BACKEND_PORT=8080
